# Whitelist approach: ignore everything by default, then explicitly
# un-ignore what belongs in the repo (code + README + build/deploy
# infra). Anything not listed below - docs, plans, specs, local
# scratch files, host-specific config - stays out.
*

!/.gitignore
!/.dockerignore
!/README.md
!/dashboard-stack.png

!/.github/
!/.github/**

!/backend/
!/backend/**

!/caddy/
!/caddy/**

!/frontend/
!/frontend/**

!/docker-compose.yaml
!/docker-compose.dev.yaml
!/docker-compose.prod.yaml

# Build artifacts / caches / local env inside whitelisted trees.
__pycache__/
*.pyc
.venv/
frontend/node_modules/
frontend/dist/
docker-compose.override.local.yaml

# Secrets - proactive, nothing like this exists today.
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
*credentials*

# Playwright MCP session output.
.playwright-mcp/

# AI agent / workflow artifacts (CLAUDE.md, agent dirs, superpowers plans &
# specs, personal TODOs) - kept on the working machine, never committed.
CLAUDE.md
.claude/
.pi/
.superpowers/
docs/superpowers/
TODO
